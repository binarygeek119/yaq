{
  "name": "yaq",
  "version": "1.0.0",
  "description": "Yet Another Queue — LAN song browser and event queue for YARG",
  "private": true,
  "type": "module",
  "bin": {
    "yaq": "./dist/yaq.cjs"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "build:server": "tsc",
    "build:bundle": "node scripts/bundle.mjs",
    "build:binary": "npm run build && npm run build:bundle && pkg . --out-path release --no-bytecode --public",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "pkg": {
    "targets": [
      "node22-linux-x64",
      "node22-win-x64"
    ],
    "assets": [
      "client/dist/**/*",
      "node_modules/better-sqlite3/**/*"
    ],
    "outputPath": "release",
    "compress": "Brotli"
  },
  "keywords": [
    "yarg",
    "queue",
    "yaq"
  ],
  "author": "Josh Skinner",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.3.0",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.3",
    "ini": "^6.0.0",
    "qrcode": "^1.5.4",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/ini": "^4.1.1",
    "@types/node": "^22.20.2",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.1",
    "@yao-pkg/pkg": "^6.22.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
